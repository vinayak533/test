{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "misty",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8791"
      ],
      "port": 8791
    },
    {
      "name": "misty-live",
      "runtimeExecutable": "node",
