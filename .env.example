# Copy to .env and fill in. Server-side only — never reference these from index.html.
# In production set the same names in Netlify → Site configuration → Environment variables.

SUPABASE_URL=https://<project-ref>.supabase.co
# Public anon key: served to the dashboard by GET /api/config for staff sign-in.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used only by npm run db:migrate / db:inspect.
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# IPv4 session pooler (Supabase → Connect → Session pooler). Preferred when set.
SUPABASE_DB_POOLER_URL=

# Jev, either way:
#   * a TypeSafe key   → TypeSafe's choice API (https://api.typesafe.ai, jev-1.13.0)
#   * an OpenRouter key (sk-or-v1-…) → "typesafe/jev-router" on OpenRouter
# The key decides; JEV_PROVIDER=typesafe|openrouter overrides. A base URL or
# model that belongs to the other provider is ignored in favour of the default.
JEV_API_KEY=
# JEV_PROVIDER=
# JEV_BASE_URL=https://openrouter.ai/api/v1
# JEV_MODEL=typesafe/jev-router
# Jev Router answers in about 2 s (slowest seen: 4 s), so allow 7 s.
JEV_TIMEOUT_MS=7000

HOTEL_TIMEZONE=Asia/Kolkata
# Holding and confirming a room in the ChatBot needs a signed-in guest account.
# Set to false only for local testing without accounts.
# BOOKING_REQUIRES_SIGN_IN=true
# Signs the ChatBot's booking-conversation state. Long and random; if unset it
# is derived from SUPABASE_SERVICE_ROLE_KEY.
CHAT_STATE_SECRET=
# Only for npm run admin:create (otherwise a password is generated and printed once).
# ADMIN_PASSWORD=
# Optional
# DEFAULT_HOTEL_ID=misty_mountain
# NLU_FALLBACK=rules        # or "off" to hand every message to the page when Jev fails
# JEV_INTENT_THRESHOLD=0.6
# JEV_HOTEL_THRESHOLD=0.6
